{
  "name": "@codbdocs/core",
  "version": "0.1.0",
  "description": "Framework-agnostic browser engine: PDF.js text extraction + Tesseract.js OCR fallback, in one document graph.",
  "main": "dist/codbdocs.js",
  "module": "src/index.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./dist/codbdocs.js"
    }
  },
  "files": ["src", "dist"],
  "peerDependencies": {
    "pdfjs-dist": ">=3.0.0",
    "tesseract.js": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": { "optional": true },
    "tesseract.js": { "optional": true }
  },
  "license": "MIT"
}
